{
	"branches": ["main"],
	"repositoryUrl": "https://github.com/devkindhq/machship-mcp.git",
	"plugins": [
		"@semantic-release/commit-analyzer",
		"@semantic-release/release-notes-generator",
		[
			"@semantic-release/exec",
			{
				"prepareCmd": "node scripts/update-version.js ${nextRelease.version} && yarn bundle"
			}
		],
		[
			"@semantic-release/npm",
			{
				"npmPublish": true,
				"pkgRoot": "."
			}
		],
		[
			"@semantic-release/github",
			{
				"assets": [
					{
						"path": "machship-mcp.mcpb",
						"label": "MCPB bundle"
					}
				]
			}
		]
	]
}
